    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android-apk": "cd android && ./gradlew clean assembleRelease && cd .. && echo \"APK created in android/app/build/outputs/apk/app-release.apk\"",
    "ios-apk": "cd ios && xcodebuild clean -workspace Monexis.xcworkspace -scheme Monexis -configuration Release && pod install && xcodebuild -workspace Monexis.xcworkspace -scheme Monexis -sdk iphonesimulator -configuration Release build"
  },
